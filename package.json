      }
    ],
    "taskDefinitions": [
      {
        "type": "taskRunnerUltimate",
        "required": [
          "script"
        ],
        "properties": {
          "script": {
            "type": "string",
            "description": "Name of the package.json script."
          },
          "manifest": {
            "type": "string",
            "description": "URI of the package.json the script belongs to."
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskRunnerUltimate",
          "title": "Task Runner",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "taskRunnerUltimate": [
