    "taskDefinitions": [
      {
        "type": "taskRunnerUltimate",
        "required": [
          "script"
        ],
        "properties": {
          "script": {
            "type": "string",
            "description": "Name of the task in its manifest."
          },
          "manifest": {
            "type": "string",
            "description": "URI of the manifest the task belongs to."
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskRunnerUltimate",
          "title": "Task & Script Explorer",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "taskRunnerUltimate": [
        {
          "id": "taskRunnerUltimate.tree",
          "name": "Task & Script Explorer",
          "icon": "media/activity-bar.svg",
          "contextualTitle": "Task & Script Explorer"
        }
      ],
      "explorer": [
        {
          "id": "taskRunnerUltimate.explorer",
          "name": "Task & Script Explorer",
          "icon": "media/activity-bar.svg",
          "contextualTitle": "Task & Script Explorer",
          "when": "config.taskRunnerUltimate.showInFileExplorer",
          "visibility": "collapsed"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "gen": "node tools/generate-contributions.js",
    "test": "node --test tools/*.test.cjs",
    "package": "vsce package",
    "publish": "npx @vscode/vsce publish",
    "publish:ovsx": "ovsx publish",
    "publish:all": "npm run publish && npm run publish:ovsx"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "ovsx": "^0.10.5",
    "typescript": "^5.4.5"
  },
  "icon": "media/icon.png"
}
