      "view/title": [
        {
          "command": "taskRunnerUltimate.restartAll",
          "group": "navigation@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && taskRunnerUltimate.runningCount > 0"
        },
        {
          "command": "taskRunnerUltimate.stopAll",
          "group": "navigation@2",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && taskRunnerUltimate.runningCount > 0"
        },
        {
          "command": "taskRunnerUltimate.show",
          "group": "navigation@3",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/"
        },
        {
          "command": "taskRunnerUltimate.menu",
          "group": "navigation@4",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/"
        }
      ],
      "view/item/context": [
        {
          "command": "taskRunnerUltimate.addFavorite",
          "group": "inline@0",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:.+:nofav$/"
        },
        {
          "command": "taskRunnerUltimate.removeFavorite",
          "group": "inline@0",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:.+:fav$/"
        },
        {
          "command": "taskRunnerUltimate.runItem",
          "group": "inline@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:idle:/"
        },
        {
          "command": "taskRunnerUltimate.restartItem",
          "group": "inline@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^(script:running:|foreignTask$)/"
        },
