      {
        "command": "taskRunnerUltimate.show",
        "key": "ctrl+alt+t",
        "mac": "ctrl+cmd+t"
      },
      {
        "command": "taskRunnerUltimate.restartActive",
        "key": "shift+enter",
        "when": "taskRunnerUltimate.pickerOpen"
      }
    ],
    "configuration": {
      "title": "Task & Script Explorer",
      "properties": {
        "taskRunnerUltimate.title": {
          "type": "string",
          "default": "Task & Script Explorer",
          "minLength": 1,
          "maxLength": 100,
          "description": "Heading over the list, in the activity bar view and in the File Explorer section alike. 1 to 100 characters; left empty it falls back to \"Task & Script Explorer\". The tooltip on the activity bar icon itself is fixed when the extension is installed and keeps the extension's name."
        },
        "taskRunnerUltimate.packageManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "yarn",
            "pnpm",
            "bun",
            "deno"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Detect from the packageManager field, the engines field, then lock and config files.",
            "npm run <script>",
            "yarn <script>",
            "pnpm run <script>",
            "bun run <script>",
            "deno task <script>"
          ],
          "description": "Runner used for package.json scripts. Tasks from deno.json(c) always use 'deno task' regardless of this setting, and no other ecosystem is affected."
        },
        "taskRunnerUltimate.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Also show a 'Task & Script Explorer' entry in the status bar."
        },
        "taskRunnerUltimate.showInEditorTitle": {
          "type": "boolean",
          "default": true,
          "description": "Show the scripts icon in the editor title bar."
        },
        "taskRunnerUltimate.showInFileExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Also show the task list as a section at the bottom of the File Explorer."
        },
        "taskRunnerUltimate.openDropdownFromActivityBar": {
          "type": "boolean",
          "default": false,
          "description": "Also open the dropdown when the Task & Script Explorer view in the activity bar is revealed. Off by default: the view already shows the same list as a tree."
        },
        "taskRunnerUltimate.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git,dist,out,build,.next,coverage,target,vendor,__pycache__,.venv,venv,.tox,.nox,.mypy_cache,.pytest_cache}/**",
          "description": "Glob pattern of manifest locations to ignore while scanning."
        },
        "taskRunnerUltimate.sources": {
          "type": "array",
          "default": [
            "node",
            "rust",
            "python",
            "make",
            "just",
            "task",
            "go",
            "php",
            "mise",
            "docker",
            "shell"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "node",
              "rust",
              "python",
              "make",
              "just",
              "task",
              "go",
              "php",
              "mise",
              "docker",
              "shell"
            ],
            "enumDescriptions": [
              "package.json (scripts) and deno.json(c) (tasks).",
              "Cargo.toml and Makefile.toml (cargo-make).",
              "pyproject.toml (poetry, pdm, hatch, rye, poe), Pipfile, tox.ini and noxfile.py.",
              "Makefile, makefile and GNUmakefile.",
              "justfile, Justfile and .justfile.",
              "Taskfile.yml and friends (go-task).",
              "go.mod — the standard go subcommands.",
              "composer.json (scripts).",
              "mise.toml and .mise.toml ([tasks]).",
              "docker-compose.yml, compose.yml and their .yaml spellings — the compose subcommands.",
              "Shell scripts (*.sh) under scripts/, bin/ and the workspace root."
            ]
          },
          "markdownDescription": "Which kinds of manifest are scanned. Remove an entry to stop reading that ecosystem entirely — the files are then never opened, which is also the fastest way to quieten a repository that carries a `Makefile` nobody runs."
        },
        "taskRunnerUltimate.cargoCommands": {
          "type": "array",
          "default": [
            "run",
            "build",
            "test",
            "clippy",
            "fmt"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "markdownDescription": "Cargo subcommands listed for every `Cargo.toml`, since a crate declares no scripts of its own. Known names (`build`, `test`, `check`, `clippy`, `fmt`, `bench`, `doc`, `clean`, `update`) get their usual flags; anything else runs as `cargo <name>`.\n\n`run` is special: it expands to what the crate can actually run — nothing for a library, one row per `[[bin]]` for a crate with several, plus a row per example."
        },
        "taskRunnerUltimate.goCommands": {
          "type": "array",
          "default": [
            "run",
            "build",
            "test",
            "vet"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "markdownDescription": "Go subcommands listed for every `go.mod`. Known names are `run`, `build`, `test`, `vet`, `fmt`, `tidy`, `generate` and `bench`; anything else runs as `go <name>`. `run` is dropped for a module whose root is not itself a program."
        },
        "taskRunnerUltimate.pythonRunner": {
          "type": "string",
          "enum": [
            "auto",
            "uv",
            "poetry",
            "pdm",
            "rye",
            "pipenv",
            "hatch",
            "none"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Detect from the lock file beside pyproject.toml, then from the [tool.*] table it configures.",
            "uv run <name>",
            "poetry run <name>",
            "pdm run <name>",
            "rye run <name>",
            "pipenv run <name>",
            "hatch run <name>",
            "Do not list [project.scripts] at all."
          ],
          "markdownDescription": "How `[project.scripts]` entry points are entered. Tasks that name their own runner — `[tool.pdm.scripts]`, `[tool.poetry.scripts]` and the rest — ignore this."
        },
        "taskRunnerUltimate.dockerCompose": {
          "type": "string",
          "enum": [
            "docker compose",
            "docker-compose"
          ],
          "default": "docker compose",
          "enumDescriptions": [
            "The v2 plugin, which is what a current Docker installs.",
            "The standalone v1 binary, end-of-life since July 2023."
          ],
          "markdownDescription": "How compose is invoked. Spelled as the command and split on whitespace, so what is written here is what reaches the terminal.\n\nThere is no `auto`: the only honest way to tell the two apart is to run `docker compose version`, and a scan never starts a process."
        },
        "taskRunnerUltimate.dockerComposeCommands": {
          "type": "array",
          "default": [
            "up",
            "down",
            "build",
            "logs",
            "ps"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "markdownDescription": "Compose subcommands listed for every compose file, since a compose file declares services rather than tasks. Known names (`up`, `down`, `build`, `logs`, `ps`, `start`, `stop`, `restart`, `pull`, `config`) get their usual flags — `logs` is followed, so the row keeps running — and anything else runs as `docker compose <name>`.\n\n`up` is special: it lists a bare row for the whole file plus one `up: <service>` row per service, whenever the file declares more than one.\n\nNothing here is ever run detached. A `-d` row would exit the moment it started, leaving the containers up and Stop with nothing to stop.\n\nEvery row passes `-f <file>`, plus a second `-f` for the `*.override.*` file beside it when there is one — which is the merge compose would have done on its own."
        },
        "taskRunnerUltimate.shellScripts": {
          "type": "array",
          "default": [
            "scripts/**/*.sh",
            "bin/**/*.sh",
            "*.sh"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "markdownDescription": "Where shell scripts are looked for, as globs relative to each workspace folder — so `*.sh` is the root level alone. Every script found becomes a row, grouped under the directory it sits in.\n\nThe executable bit is deliberately not consulted: it is invisible to VS Code’s own file API, and reading it would mean giving up Remote SSH and Dev Containers. The convention — a `.sh` in `scripts/`, `bin/` or the root — is the signal instead.\n\nAt most 200 scripts are read, budgeted apart from the manifests. Narrow these patterns if a repository has more."
        },
        "taskRunnerUltimate.shellRunner": {
          "type": "string",
          "default": "bash",
          "markdownDescription": "What a shell row is run through, from the workspace folder root: `bash ./scripts/deploy.sh`. Leave empty to run the path on its own, which then needs both the executable bit and a shebang.\n\nOn Windows this wants Git Bash or WSL on the `PATH`."
        },
        "taskRunnerUltimate.colorIcons": {
          "type": "boolean",
          "default": true,
          "description": "Tint script icons in the Task & Script Explorer view with their category colour. Turn off to keep every icon in the default foreground colour."
        },
        "taskRunnerUltimate.pinRunningTasks": {
          "type": "boolean",
          "default": false,
          "description": "Show running tasks first inside the group they belong to, in the tree and in the dropdown alike. Off by default: a row that stays put is a row you stop where you started it."
        },
        "taskRunnerUltimate.grouping": {
          "type": "string",
          "enum": [
            "flat",
            "ecosystem"
          ],
          "default": "flat",
          "enumDescriptions": [
            "One row per manifest, all at the top level.",
            "One row per ecosystem, with that ecosystem’s manifests inside it."
          ],
          "markdownDescription": "How the package headings are arranged, in the tree and in the dropdown alike. `ecosystem` gathers the manifests of each language or runner under a row of their own, which is what a polyglot repository reads better as; the order inside a run is still yours to drag.\n\nAlso on the ☰ menu, as **Group by ecosystem**."
        },
        "taskRunnerUltimate.groupIcons": {
          "type": "string",
          "enum": [
            "type",
            "uniform"
          ],
          "default": "type",
          "enumDescriptions": [
            "Each heading wears its ecosystem’s glyph, in that ecosystem’s colour.",
            "Every heading wears the same stack glyph."
          ],
          "markdownDescription": "What a package heading is drawn with. `type` is what tells a Node heading from a Rust one at a glance; `uniform` is the quieter column the tree used to have, for when the headings should stay out of the way of the rows under them.\n\nAn icon picked by hand on a row wins over both."
        },
        "taskRunnerUltimate.categories": {
          "type": "array",
          "default": [],
          "markdownDescription": "Extra category rules, checked **before** the built-in ones (run, test, quality, build, release, data, clean), so a single entry can override a built-in. Each rule matches the script name token by token, then the command it runs.\n\n```json\n[{ \"match\": [\"bench\", \"perf\"], \"icon\": \"dashboard\", \"color\": \"charts.purple\" }]\n```\n\n`icon` is a codicon id, `color` a theme colour id — either one of `taskRunnerUltimate.category.*` or any built-in such as `charts.green`.",
          "items": {
            "type": "object",
            "required": [
              "match",
              "icon",
              "color"
            ],
            "properties": {
              "match": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Lower-case tokens matched against the script name, then against its command."
              },
              "icon": {
                "type": "string",
                "description": "Codicon id, e.g. \"beaker\"."
              },
              "color": {
                "type": "string",
                "description": "Theme colour id used to tint the icon."
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
