{
  "name": "task-runner-ultimate",
  "displayName": "Task & Script Explorer🏆",
  "description": "Task and script explorer with one list in your monorepo: package.json, Cargo.toml, pyproject.toml, Makefile, justfile, Taskfile and more. Batch & single run, stop and restart from anywhere, with a live count of what's running.",
  "version": "0.5.5",
  "publisher": "DenysDavydov",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Denis-Davidoff/vs-code-task-runner-ultimate.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "task explorer",
    "tasks explorer",
    "scripts explorer",
    "script exporer",
    "task script explorer",
    "npm scripts",
    "run npm script",
    "package.json scripts",
    "task runner",
    "run manager",
    "tasks",
    "task manager",
    "run task",
    "run script",
    "npm run",
    "package manager",
    "script manager",
    "script runner",
    "yarn",
    "pnpm",
    "bun",
    "deno task",
    "cargo",
    "rust",
    "python",
    "poetry",
    "uv",
    "make",
    "makefile",
    "just",
    "justfile",
    "taskfile",
    "go",
    "composer",
    "mise",
    "monorepo",
    "workspace scripts",
    "terminal",
    "dev server",
    "watch"
  ],
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/deno.json",
    "workspaceContains:**/deno.jsonc",
    "workspaceContains:**/composer.json",
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/Makefile.toml",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/Pipfile",
    "workspaceContains:**/tox.ini",
    "workspaceContains:**/noxfile.py",
    "workspaceContains:**/Makefile",
    "workspaceContains:**/makefile",
    "workspaceContains:**/GNUmakefile",
    "workspaceContains:**/justfile",
    "workspaceContains:**/Justfile",
    "workspaceContains:**/.justfile",
    "workspaceContains:**/Taskfile.yml",
    "workspaceContains:**/Taskfile.yaml",
    "workspaceContains:**/Taskfile.dist.yml",
    "workspaceContains:**/Taskfile.dist.yaml",
    "workspaceContains:**/taskfile.yml",
    "workspaceContains:**/taskfile.yaml",
    "workspaceContains:**/go.mod",
    "workspaceContains:**/mise.toml",
    "workspaceContains:**/.mise.toml",
    "onTaskType:taskRunnerUltimate",
    "onView:taskRunnerUltimate.tree",
    "onView:taskRunnerUltimate.explorer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "taskRunnerUltimate.show",
        "title": "Show Scripts",
        "category": "Task & Script Explorer",
        "icon": {
          "light": "media/scripts-light.svg",
          "dark": "media/scripts-dark.svg"
        }
      },
      {
        "command": "taskRunnerUltimate.show.badge1",
        "title": "Show Scripts (1 running)",
        "category": "Task & Script Explorer",
        "icon": {
          "light": "media/scripts-light-1.svg",
          "dark": "media/scripts-dark-1.svg"
