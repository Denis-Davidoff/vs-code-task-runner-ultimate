{
  "name": "task-runner-ultimate",
  "displayName": "Task Runner 🏆 Ultimate",
  "description": "Every script in the workspace and every running task in one dropdown: Enter starts or stops, Shift+Enter restarts, and the toolbar icon badges how many tasks are running. npm, yarn, pnpm, bun and deno.",
  "version": "0.2.1",
  "publisher": "DenysDavydov",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Denis-Davidoff/vs-code-task-runner-ultimate.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "npm scripts",
    "run npm script",
    "package.json scripts",
    "node scripts",
    "node package",
    "node package scripts",
    "task runner",
    "tasks",
    "script runner",
    "yarn",
    "pnpm",
    "bun",
    "deno task",
    "monorepo",
    "workspace scripts",
    "terminal",
    "dev server",
    "watch"
  ],
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/deno.json",
    "workspaceContains:**/deno.jsonc",
    "onTaskType:taskRunnerUltimate",
    "onView:taskRunnerUltimate.tree"
  ],
  "main": "./out/extension.js",
  "contributes": {
