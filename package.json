          "group": "0_open@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^group:package(:hidden)?(:running)?$/"
        },
        {
          "command": "taskRunnerUltimate.showTerminal",
          "group": "0_open@2",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^(script:running:|foreignTask$)/"
        },
        {
          "command": "taskRunnerUltimate.openTerminalEditor",
          "group": "0_open@3",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^(script:running:|foreignTask$)/"
        },
        {
          "command": "taskRunnerUltimate.addFavorite",
          "group": "1_favorites@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:.+:nofav:/"
        },
        {
          "command": "taskRunnerUltimate.removeFavorite",
          "group": "1_favorites@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:.+:fav:/"
        },
        {
          "command": "taskRunnerUltimate.enableConfirmation",
          "group": "1_favorites@2",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:.+:noconfirm$/"
        },
        {
          "command": "taskRunnerUltimate.disableConfirmation",
          "group": "1_favorites@2",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:.+:confirm$/"
        },
        {
          "command": "taskRunnerUltimate.editTitle",
          "group": "2_modify@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:/"
        },
        {
          "command": "taskRunnerUltimate.editTitle",
          "group": "2_modify@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^group:package(:hidden)?(:running)?$/"
        },
        {
          "submenu": "taskRunnerUltimate.color",
          "group": "2_modify@2",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^(script|group)/"
        },
        {
          "command": "taskRunnerUltimate.pickIcon",
          "group": "2_modify@3",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^(script|group)/"
        },
        {
          "command": "taskRunnerUltimate.showGroup",
          "group": "inline@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^group:package:hidden(:running)?$/"
        },
        {
          "command": "taskRunnerUltimate.hideGroup",
          "group": "2_modify@4",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^group:package(:running)?$/"
        },
        {
          "command": "taskRunnerUltimate.showGroup",
          "group": "2_modify@4",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^group:package:hidden(:running)?$/"
        }
      ],
      "taskRunnerUltimate.color": [
