    "keybindings": [
      {
        "command": "packageScripts.show",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "packageScripts.restartActive",
        "key": "shift+enter",
        "when": "packageScripts.pickerOpen"
      }
    ],
    "configuration": {
      "title": "Package Scripts List",
      "properties": {
        "packageScripts.packageManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "yarn",
            "pnpm",
            "bun",
            "deno"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Detect from the packageManager field, the engines field, then lock and config files.",
            "npm run <script>",
            "yarn <script>",
            "pnpm run <script>",
            "bun run <script>",
            "deno task <script>"
          ],
          "description": "Runner used for package.json scripts. Tasks from deno.json(c) always use 'deno task' regardless of this setting."
        },
        "packageScripts.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Also show a 'Scripts' entry in the status bar."
        },
        "packageScripts.showInEditorTitle": {
          "type": "boolean",
          "default": true,
          "description": "Show the scripts icon (with the running-task badge) in the editor title bar."
        },
        "packageScripts.openDropdownFromActivityBar": {
          "type": "boolean",
          "default": false,
          "description": "Also open the dropdown when the Scripts view in the activity bar is revealed. Off by default: the view already shows the same list as a tree."
        },
        "packageScripts.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git,dist,out,build,.next,coverage}/**",
          "description": "Glob pattern of package.json locations to ignore."
        },
        "packageScripts.colorIcons": {
          "type": "boolean",
          "default": true,
          "description": "Tint script icons in the Scripts view with their category colour. Turn off to keep every icon in the default foreground colour."
        },
        "packageScripts.categories": {
          "type": "array",
          "default": [],
          "markdownDescription": "Extra category rules, checked **before** the built-in ones (run, test, quality, build, release, data, clean), so a single entry can override a built-in. Each rule matches the script name token by token, then the command it runs.\n\n```json\n[{ \"match\": [\"bench\", \"perf\"], \"icon\": \"dashboard\", \"color\": \"charts.purple\" }]\n```\n\n`icon` is a codicon id, `color` a theme colour id — either one of `packageScripts.category.*` or any built-in such as `charts.green`.",
          "items": {
            "type": "object",
            "required": [
              "match",
              "icon",
              "color"
            ],
            "properties": {
              "match": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Lower-case tokens matched against the script name, then against its command."
              },
              "icon": {
                "type": "string",
                "description": "Codicon id, e.g. \"beaker\"."
              },
              "color": {
                "type": "string",
                "description": "Theme colour id used to tint the icon."
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "colors": [
      {
        "id": "packageScripts.sourceTitleForeground",
        "description": "Colour of the source titles (package / manifest names) in the Scripts view.",
        "defaults": {
          "dark": "#D7BA7D",
          "light": "#B58900",
          "highContrast": "#F0C674",
          "highContrastLight": "#8F6A00"
        }
