    "keybindings": [
      {
        "command": "taskRunnerUltimate.show",
        "key": "ctrl+alt+t",
        "mac": "ctrl+cmd+t"
      },
      {
        "command": "taskRunnerUltimate.restartActive",
        "key": "shift+enter",
        "when": "taskRunnerUltimate.pickerOpen"
      }
    ],
    "configuration": {
      "title": "Task Runner Ultimate",
      "properties": {
        "taskRunnerUltimate.packageManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "yarn",
            "pnpm",
            "bun",
            "deno"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Detect from the packageManager field, the engines field, then lock and config files.",
            "npm run <script>",
            "yarn <script>",
            "pnpm run <script>",
            "bun run <script>",
            "deno task <script>"
          ],
          "description": "Runner used for package.json scripts. Tasks from deno.json(c) always use 'deno task' regardless of this setting."
        },
        "taskRunnerUltimate.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Also show a 'Task Runner' entry in the status bar."
        },
        "taskRunnerUltimate.showInEditorTitle": {
          "type": "boolean",
          "default": true,
          "description": "Show the scripts icon (with the running-task badge) in the editor title bar."
        },
        "taskRunnerUltimate.openDropdownFromActivityBar": {
          "type": "boolean",
          "default": false,
          "description": "Also open the dropdown when the Task Runner view in the activity bar is revealed. Off by default: the view already shows the same list as a tree."
        },
        "taskRunnerUltimate.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git,dist,out,build,.next,coverage}/**",
          "description": "Glob pattern of package.json locations to ignore."
        },
        "taskRunnerUltimate.colorIcons": {
          "type": "boolean",
          "default": true,
          "description": "Tint script icons in the Task Runner view with their category colour. Turn off to keep every icon in the default foreground colour."
        },
        "taskRunnerUltimate.categories": {
          "type": "array",
          "default": [],
          "markdownDescription": "Extra category rules, checked **before** the built-in ones (run, test, quality, build, release, data, clean), so a single entry can override a built-in. Each rule matches the script name token by token, then the command it runs.\n\n```json\n[{ \"match\": [\"bench\", \"perf\"], \"icon\": \"dashboard\", \"color\": \"charts.purple\" }]\n```\n\n`icon` is a codicon id, `color` a theme colour id — either one of `taskRunnerUltimate.category.*` or any built-in such as `charts.green`.",
          "items": {
            "type": "object",
            "required": [
              "match",
              "icon",
              "color"
            ],
            "properties": {
              "match": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Lower-case tokens matched against the script name, then against its command."
              },
              "icon": {
                "type": "string",
                "description": "Codicon id, e.g. \"beaker\"."
              },
              "color": {
                "type": "string",
                "description": "Theme colour id used to tint the icon."
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "colors": [
      {
        "id": "taskRunnerUltimate.sourceTitleForeground",
        "description": "Colour of the source titles (package / manifest names) in the Task Runner view.",
        "defaults": {
          "dark": "#D7BA7D",
          "light": "#B58900",
          "highContrast": "#F0C674",
          "highContrastLight": "#8F6A00"
        }
      },
      {
        "id": "taskRunnerUltimate.category.run",
        "description": "Icon colour in the Task Runner view: Running a dev server or watcher.",
        "defaults": {
          "dark": "#73C991",
          "light": "#388A34",
          "highContrast": "#89D185",
          "highContrastLight": "#0B6A0B"
        }
      },
      {
        "id": "taskRunnerUltimate.category.test",
        "description": "Icon colour in the Task Runner view: Tests and coverage.",
        "defaults": {
          "dark": "#F14C4C",
          "light": "#E51400",
          "highContrast": "#FF8A8A",
          "highContrastLight": "#B5000F"
        }
      },
      {
        "id": "taskRunnerUltimate.category.quality",
        "description": "Icon colour in the Task Runner view: Linting, formatting and type checking.",
        "defaults": {
          "dark": "#75BEFF",
          "light": "#0066BF",
          "highContrast": "#9CDCFE",
          "highContrastLight": "#004E8C"
        }
      },
      {
        "id": "taskRunnerUltimate.category.build",
