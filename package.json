        {
          "command": "taskRunnerUltimate.show",
          "group": "navigation@1",
          "when": "config.taskRunnerUltimate.showInEditorTitle && !taskRunnerUltimate.runningCount"
        },
        {
          "command": "taskRunnerUltimate.show.badge1",
          "group": "navigation@1",
          "when": "config.taskRunnerUltimate.showInEditorTitle && taskRunnerUltimate.runningCount == 1"
        },
