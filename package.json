{
  "name": "handy-task-runner",
  "displayName": "Handy 🏆 Task Runner",
  "description": "Every script in the workspace and every running task in one dropdown: Enter starts or stops, Shift+Enter restarts, and the toolbar icon badges how many tasks are running. npm, yarn, pnpm, bun and deno.",
  "version": "0.1.5",
  "publisher": "DenysDavydov",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Denis-Davidoff/vs-code-handy-task-runner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "npm scripts",
    "run npm script",
    "package.json scripts",
    "node scripts",
    "node package",
    "node package scripts",
    "task runner",
    "tasks",
    "script runner",
    "yarn",
    "pnpm",
    "bun",
    "deno task",
    "monorepo",
    "workspace scripts",
    "terminal",
    "dev server",
    "watch"
  ],
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/deno.json",
    "workspaceContains:**/deno.jsonc",
    "onTaskType:handyTasksRunner",
    "onView:handyTasksRunner.tree"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "handyTasksRunner.show",
        "title": "Show Scripts",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light.svg",
          "dark": "media/scripts-dark.svg"
        }
      },
      {
        "command": "handyTasksRunner.show.badge1",
        "title": "Show Scripts (1 running)",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light-1.svg",
          "dark": "media/scripts-dark-1.svg"
        }
      },
      {
        "command": "handyTasksRunner.show.badge2",
        "title": "Show Scripts (2 running)",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light-2.svg",
          "dark": "media/scripts-dark-2.svg"
        }
      },
      {
        "command": "handyTasksRunner.show.badge3",
        "title": "Show Scripts (3 running)",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light-3.svg",
          "dark": "media/scripts-dark-3.svg"
        }
      },
      {
        "command": "handyTasksRunner.show.badge4",
        "title": "Show Scripts (4 running)",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light-4.svg",
          "dark": "media/scripts-dark-4.svg"
        }
      },
      {
        "command": "handyTasksRunner.show.badge5",
        "title": "Show Scripts (5 running)",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light-5.svg",
          "dark": "media/scripts-dark-5.svg"
        }
      },
      {
        "command": "handyTasksRunner.show.badge6",
        "title": "Show Scripts (6 running)",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light-6.svg",
          "dark": "media/scripts-dark-6.svg"
        }
      },
      {
        "command": "handyTasksRunner.show.badge7",
        "title": "Show Scripts (7 running)",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light-7.svg",
          "dark": "media/scripts-dark-7.svg"
        }
      },
      {
        "command": "handyTasksRunner.show.badge8",
        "title": "Show Scripts (8 running)",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light-8.svg",
          "dark": "media/scripts-dark-8.svg"
        }
      },
      {
        "command": "handyTasksRunner.show.badge9",
        "title": "Show Scripts (9 running)",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light-9.svg",
          "dark": "media/scripts-dark-9.svg"
        }
      },
      {
        "command": "handyTasksRunner.show.badgeMany",
        "title": "Show Scripts (9+ running)",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/scripts-light-many.svg",
          "dark": "media/scripts-dark-many.svg"
        }
      },
      {
        "command": "handyTasksRunner.restartActive",
        "title": "Restart Focused Script",
        "category": "Handy Task Runner",
        "icon": "$(debug-restart)"
      },
      {
        "command": "handyTasksRunner.refresh",
        "title": "Refresh Scripts",
        "category": "Handy Task Runner",
        "icon": "$(refresh)"
      },
      {
        "command": "handyTasksRunner.runItem",
        "title": "Run",
        "category": "Handy Task Runner",
        "icon": "$(play)"
      },
      {
        "command": "handyTasksRunner.stopItem",
        "title": "Stop",
        "category": "Handy Task Runner",
        "icon": "$(debug-stop)"
      },
      {
        "command": "handyTasksRunner.restartItem",
        "title": "Restart",
        "category": "Handy Task Runner",
        "icon": "$(debug-restart)"
      },
      {
        "command": "handyTasksRunner.toggleItem",
        "title": "Run or Stop",
        "category": "Handy Task Runner"
      },
      {
        "command": "handyTasksRunner.stopAll",
        "title": "Stop All Running Tasks",
        "category": "Handy Task Runner",
        "icon": {
          "light": "media/stop-all-light.svg",
          "dark": "media/stop-all-dark.svg"
        }
      },
      {
        "command": "handyTasksRunner.restartAll",
        "title": "Restart All Running Tasks",
        "category": "Handy Task Runner",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "handyTasksRunner.show",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && !handyTasksRunner.runningCount"
        },
        {
          "command": "handyTasksRunner.show.badge1",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 1"
        },
        {
          "command": "handyTasksRunner.show.badge2",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 2"
        },
        {
          "command": "handyTasksRunner.show.badge3",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 3"
        },
        {
          "command": "handyTasksRunner.show.badge4",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 4"
        },
        {
          "command": "handyTasksRunner.show.badge5",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 5"
        },
        {
          "command": "handyTasksRunner.show.badge6",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 6"
        },
        {
          "command": "handyTasksRunner.show.badge7",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 7"
        },
        {
          "command": "handyTasksRunner.show.badge8",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 8"
        },
        {
          "command": "handyTasksRunner.show.badge9",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 9"
        },
        {
          "command": "handyTasksRunner.show.badgeMany",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 10"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "handyTasksRunner.show",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && !handyTasksRunner.runningCount"
        },
        {
          "command": "handyTasksRunner.show.badge1",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 1"
        },
        {
          "command": "handyTasksRunner.show.badge2",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 2"
        },
        {
          "command": "handyTasksRunner.show.badge3",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 3"
        },
        {
          "command": "handyTasksRunner.show.badge4",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 4"
        },
        {
          "command": "handyTasksRunner.show.badge5",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 5"
        },
        {
          "command": "handyTasksRunner.show.badge6",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 6"
        },
        {
          "command": "handyTasksRunner.show.badge7",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 7"
        },
        {
          "command": "handyTasksRunner.show.badge8",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 8"
        },
        {
          "command": "handyTasksRunner.show.badge9",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 9"
        },
        {
          "command": "handyTasksRunner.show.badgeMany",
          "group": "navigation@1",
          "when": "config.handyTasksRunner.showInEditorTitle && handyTasksRunner.runningCount == 10"
        }
      ],
      "view/title": [
        {
          "command": "handyTasksRunner.restartAll",
          "group": "navigation@1",
          "when": "view == handyTasksRunner.tree && handyTasksRunner.runningCount > 0"
        },
        {
          "command": "handyTasksRunner.stopAll",
          "group": "navigation@2",
          "when": "view == handyTasksRunner.tree && handyTasksRunner.runningCount > 0"
        },
        {
          "command": "handyTasksRunner.show",
          "group": "navigation@3",
          "when": "view == handyTasksRunner.tree"
        },
        {
          "command": "handyTasksRunner.refresh",
          "group": "navigation@4",
          "when": "view == handyTasksRunner.tree"
        }
      ],
      "view/item/context": [
        {
          "command": "handyTasksRunner.runItem",
          "group": "inline@1",
          "when": "view == handyTasksRunner.tree && viewItem == idleScript"
        },
        {
          "command": "handyTasksRunner.restartItem",
          "group": "inline@1",
          "when": "view == handyTasksRunner.tree && viewItem =~ /^(runningScript|foreignTask)$/"
        },
        {
          "command": "handyTasksRunner.stopItem",
          "group": "inline@2",
          "when": "view == handyTasksRunner.tree && viewItem =~ /^(runningScript|foreignTask)$/"
        }
      ],
      "commandPalette": [
        {
          "command": "handyTasksRunner.show.badge1",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.show.badge2",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.show.badge3",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.show.badge4",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.show.badge5",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.show.badge6",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.show.badge7",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.show.badge8",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.show.badge9",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.show.badgeMany",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.restartActive",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.runItem",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.stopItem",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.restartItem",
          "when": "false"
        },
        {
          "command": "handyTasksRunner.toggleItem",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "handyTasksRunner.show",
        "key": "ctrl+alt+t",
        "mac": "ctrl+cmd+t"
      },
      {
        "command": "handyTasksRunner.restartActive",
        "key": "shift+enter",
        "when": "handyTasksRunner.pickerOpen"
      }
    ],
    "configuration": {
      "title": "Handy Task Runner",
      "properties": {
        "handyTasksRunner.packageManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "yarn",
            "pnpm",
            "bun",
            "deno"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Detect from the packageManager field, the engines field, then lock and config files.",
            "npm run <script>",
            "yarn <script>",
            "pnpm run <script>",
            "bun run <script>",
            "deno task <script>"
          ],
          "description": "Runner used for package.json scripts. Tasks from deno.json(c) always use 'deno task' regardless of this setting."
        },
        "handyTasksRunner.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Also show a 'Handy Tasks' entry in the status bar."
        },
        "handyTasksRunner.showInEditorTitle": {
          "type": "boolean",
          "default": true,
          "description": "Show the scripts icon (with the running-task badge) in the editor title bar."
        },
        "handyTasksRunner.openDropdownFromActivityBar": {
          "type": "boolean",
          "default": false,
          "description": "Also open the dropdown when the Handy Tasks view in the activity bar is revealed. Off by default: the view already shows the same list as a tree."
        },
        "handyTasksRunner.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git,dist,out,build,.next,coverage}/**",
          "description": "Glob pattern of package.json locations to ignore."
        },
        "handyTasksRunner.colorIcons": {
          "type": "boolean",
          "default": true,
          "description": "Tint script icons in the Handy Tasks view with their category colour. Turn off to keep every icon in the default foreground colour."
        },
        "handyTasksRunner.categories": {
          "type": "array",
          "default": [],
          "markdownDescription": "Extra category rules, checked **before** the built-in ones (run, test, quality, build, release, data, clean), so a single entry can override a built-in. Each rule matches the script name token by token, then the command it runs.\n\n```json\n[{ \"match\": [\"bench\", \"perf\"], \"icon\": \"dashboard\", \"color\": \"charts.purple\" }]\n```\n\n`icon` is a codicon id, `color` a theme colour id — either one of `handyTasksRunner.category.*` or any built-in such as `charts.green`.",
          "items": {
            "type": "object",
            "required": [
              "match",
              "icon",
              "color"
            ],
            "properties": {
              "match": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Lower-case tokens matched against the script name, then against its command."
              },
              "icon": {
                "type": "string",
                "description": "Codicon id, e.g. \"beaker\"."
              },
              "color": {
                "type": "string",
                "description": "Theme colour id used to tint the icon."
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "colors": [
      {
        "id": "handyTasksRunner.sourceTitleForeground",
        "description": "Colour of the source titles (package / manifest names) in the Handy Tasks view.",
        "defaults": {
          "dark": "#D7BA7D",
          "light": "#B58900",
          "highContrast": "#F0C674",
          "highContrastLight": "#8F6A00"
        }
      },
      {
        "id": "handyTasksRunner.category.run",
        "description": "Icon colour in the Handy Tasks view: Running a dev server or watcher.",
        "defaults": {
          "dark": "#73C991",
          "light": "#388A34",
          "highContrast": "#89D185",
          "highContrastLight": "#0B6A0B"
        }
      },
      {
        "id": "handyTasksRunner.category.test",
        "description": "Icon colour in the Handy Tasks view: Tests and coverage.",
        "defaults": {
          "dark": "#F14C4C",
          "light": "#E51400",
          "highContrast": "#FF8A8A",
          "highContrastLight": "#B5000F"
        }
      },
      {
        "id": "handyTasksRunner.category.quality",
        "description": "Icon colour in the Handy Tasks view: Linting, formatting and type checking.",
        "defaults": {
          "dark": "#75BEFF",
          "light": "#0066BF",
          "highContrast": "#9CDCFE",
          "highContrastLight": "#004E8C"
        }
      },
      {
        "id": "handyTasksRunner.category.build",
        "description": "Icon colour in the Handy Tasks view: Building, bundling and packaging.",
        "defaults": {
          "dark": "#D18616",
          "light": "#BF8803",
          "highContrast": "#E8A33D",
          "highContrastLight": "#8A5A00"
        }
      },
      {
        "id": "handyTasksRunner.category.release",
        "description": "Icon colour in the Handy Tasks view: Releasing, publishing and deploying.",
        "defaults": {
          "dark": "#B180D7",
          "light": "#652D90",
          "highContrast": "#C8A2E0",
          "highContrastLight": "#4B1D6E"
        }
      },
      {
        "id": "handyTasksRunner.category.data",
        "description": "Icon colour in the Handy Tasks view: Migrations, seeds and code generation.",
        "defaults": {
          "dark": "#4EC9B0",
          "light": "#0F8A82",
          "highContrast": "#7EE0CC",
          "highContrastLight": "#0A5E58"
        }
      },
      {
        "id": "handyTasksRunner.category.clean",
        "description": "Icon colour in the Handy Tasks view: Cleaning and resetting.",
        "defaults": {
          "dark": "#9D9D9D",
          "light": "#767676",
          "highContrast": "#B0B0B0",
          "highContrastLight": "#5A5A5A"
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "handyTasksRunner",
        "required": [
          "script"
        ],
        "properties": {
          "script": {
            "type": "string",
            "description": "Name of the package.json script."
          },
          "manifest": {
            "type": "string",
            "description": "URI of the package.json the script belongs to."
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "handyTasksRunner",
          "title": "Handy Tasks",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "handyTasksRunner": [
        {
          "id": "handyTasksRunner.tree",
          "name": "Handy Tasks",
          "icon": "media/activity-bar.svg",
          "contextualTitle": "Handy Tasks"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "gen": "node tools/generate-contributions.js",
    "package": "vsce package",
    "publish": "npx @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  },
  "icon": "media/icon.png"
}
