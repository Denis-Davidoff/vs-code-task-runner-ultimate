      },
      {
        "command": "packageScripts.stopItem",
        "title": "Stop",
        "category": "Package Scripts",
        "icon": "$(debug-stop)"
      },
      {
        "command": "packageScripts.restartItem",
        "title": "Restart",
        "category": "Package Scripts",
        "icon": "$(debug-restart)"
      },
      {
        "command": "packageScripts.toggleItem",
        "title": "Run or Stop",
        "category": "Package Scripts"
      },
      {
        "command": "packageScripts.stopAll",
        "title": "Stop All Running Tasks",
        "category": "Package Scripts",
        "icon": "$(stop-circle)"
      },
      {
        "command": "packageScripts.restartAll",
        "title": "Restart All Running Tasks",
        "category": "Package Scripts",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
