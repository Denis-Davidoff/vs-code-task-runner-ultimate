    "submenus": [
      {
        "id": "taskRunnerUltimate.color",
        "label": "Colour",
        "icon": "$(symbol-color)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "taskRunnerUltimate.show",
          "group": "navigation@1",
          "when": "config.taskRunnerUltimate.showInEditorTitle"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "taskRunnerUltimate.show",
          "group": "navigation@1",
          "when": "config.taskRunnerUltimate.showInEditorTitle"
        }
      ],
      "view/title": [
        {
          "command": "taskRunnerUltimate.restartAll",
          "group": "navigation@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && taskRunnerUltimate.runningCount > 0"
        },
        {
          "command": "taskRunnerUltimate.stopAll",
          "group": "navigation@2",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && taskRunnerUltimate.runningCount > 0"
        },
        {
          "command": "taskRunnerUltimate.show",
          "group": "navigation@3",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/"
        },
        {
          "command": "taskRunnerUltimate.menu",
          "group": "navigation@4",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/"
        }
      ],
      "view/item/context": [
        {
          "command": "taskRunnerUltimate.addFavorite",
          "group": "inline@0",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:.+:nofav:/"
        },
        {
          "command": "taskRunnerUltimate.removeFavorite",
          "group": "inline@0",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:.+:fav:/"
        },
        {
          "command": "taskRunnerUltimate.runItem",
          "group": "inline@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:idle:/"
        },
        {
          "command": "taskRunnerUltimate.restartItem",
          "group": "inline@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^(script:running:|foreignTask$)/"
        },
        {
          "command": "taskRunnerUltimate.stopItem",
          "group": "inline@2",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^(script:running:|foreignTask$)/"
        },
        {
          "command": "taskRunnerUltimate.restartGroup",
          "group": "inline@2",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^group:(package(:hidden)?|eco):running$/"
        },
        {
          "command": "taskRunnerUltimate.stopGroup",
          "group": "inline@3",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^group:(package(:hidden)?|eco):running$/"
        },
        {
          "command": "taskRunnerUltimate.runItemMenu",
          "group": "0_actions@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:idle:/"
        },
        {
          "command": "taskRunnerUltimate.stopItemMenu",
          "group": "0_actions@2",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^(script:running:|foreignTask$)/"
        },
        {
          "command": "taskRunnerUltimate.openScript",
          "group": "0_open@1",
          "when": "view =~ /^taskRunnerUltimate\\.(tree|explorer)$/ && viewItem =~ /^script:/"
        },
        {
