{
  "name": "task-runner-ultimate",
  "displayName": "Task & Script Explorer🏆",
  "description": "Task and script explorer with one list in your monorepo: package.json, Cargo.toml, pyproject.toml, Makefile, justfile, Taskfile and more. Batch & single run, stop and restart from anywhere, with a live count of what's running.",
  "version": "0.7.3",
  "publisher": "DenysDavydov",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Denis-Davidoff/vs-code-task-runner-ultimate.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "task explorer",
    "tasks explorer",
    "scripts explorer",
    "script exporer",
    "task script explorer",
    "npm scripts",
    "run npm script",
    "package.json scripts",
    "task runner",
    "run manager",
    "tasks",
    "task manager",
    "run task",
    "run script",
    "npm run",
    "package manager",
    "script manager",
    "script runner",
    "yarn",
    "pnpm",
    "bun",
    "deno task",
    "cargo",
    "rust",
    "python",
    "poetry",
    "uv",
    "make",
    "makefile",
    "just",
    "justfile",
    "taskfile",
    "go",
    "composer",
    "mise",
    "monorepo",
    "workspace scripts",
    "terminal",
    "dev server",
    "watch"
  ],
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/deno.json",
    "workspaceContains:**/deno.jsonc",
    "workspaceContains:**/composer.json",
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/Makefile.toml",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/Pipfile",
    "workspaceContains:**/tox.ini",
    "workspaceContains:**/noxfile.py",
    "workspaceContains:**/Makefile",
    "workspaceContains:**/makefile",
    "workspaceContains:**/GNUmakefile",
    "workspaceContains:**/justfile",
    "workspaceContains:**/Justfile",
    "workspaceContains:**/.justfile",
    "workspaceContains:**/Taskfile.yml",
    "workspaceContains:**/Taskfile.yaml",
    "workspaceContains:**/Taskfile.dist.yml",
    "workspaceContains:**/Taskfile.dist.yaml",
    "workspaceContains:**/taskfile.yml",
    "workspaceContains:**/taskfile.yaml",
    "workspaceContains:**/go.mod",
    "workspaceContains:**/mise.toml",
    "workspaceContains:**/.mise.toml",
    "workspaceContains:**/docker-compose.yml",
    "workspaceContains:**/docker-compose.yaml",
    "workspaceContains:**/compose.yml",
    "workspaceContains:**/compose.yaml",
    "workspaceContains:scripts/*.sh",
    "workspaceContains:bin/*.sh",
    "onTaskType:taskRunnerUltimate",
    "onView:taskRunnerUltimate.tree",
    "onView:taskRunnerUltimate.explorer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "taskRunnerUltimate.show",
        "title": "Show Scripts",
        "category": "Task & Script Explorer",
        "icon": {
          "light": "media/scripts-light.svg",
          "dark": "media/scripts-dark.svg"
        }
      },
      {
        "command": "taskRunnerUltimate.restartActive",
        "title": "Restart Focused Script",
        "category": "Task & Script Explorer",
        "icon": "$(debug-restart)"
      },
      {
        "command": "taskRunnerUltimate.refresh",
        "title": "Refresh Scripts",
        "category": "Task & Script Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "taskRunnerUltimate.runItem",
        "title": "Run",
        "category": "Task & Script Explorer",
        "icon": "$(play)"
      },
      {
        "command": "taskRunnerUltimate.stopItem",
        "title": "Stop",
        "category": "Task & Script Explorer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskRunnerUltimate.restartItem",
        "title": "Restart",
        "category": "Task & Script Explorer",
        "icon": "$(debug-restart)"
      },
      {
        "command": "taskRunnerUltimate.toggleItem",
        "title": "Run, Show Terminal or Stop",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.runItemMenu",
        "title": "Run (Click)",
        "category": "Task & Script Explorer",
        "icon": "$(play)"
      },
      {
        "command": "taskRunnerUltimate.stopItemMenu",
        "title": "Stop (Double-Click)",
        "category": "Task & Script Explorer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskRunnerUltimate.addFavorite",
        "title": "Add to Favorites",
        "category": "Task & Script Explorer",
        "icon": "$(star-empty)"
      },
      {
        "command": "taskRunnerUltimate.removeFavorite",
        "title": "Remove from Favorites",
        "category": "Task & Script Explorer",
        "icon": "$(star-full)"
      },
      {
        "command": "taskRunnerUltimate.enableConfirmation",
        "title": "Enable Confirmation",
        "category": "Task & Script Explorer",
        "icon": "$(question)"
      },
      {
        "command": "taskRunnerUltimate.disableConfirmation",
        "title": "Disable Confirmation",
        "category": "Task & Script Explorer",
        "icon": "$(question)"
      },
      {
        "command": "taskRunnerUltimate.editTitle",
        "title": "Rename…",
        "category": "Task & Script Explorer",
        "icon": "$(edit)"
      },
      {
        "command": "taskRunnerUltimate.hideGroup",
        "title": "Hide Package",
        "category": "Task & Script Explorer",
        "icon": "$(eye-closed)"
      },
      {
        "command": "taskRunnerUltimate.stopGroup",
        "title": "Stop All in Package",
        "category": "Task & Script Explorer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskRunnerUltimate.restartGroup",
        "title": "Restart All in Package",
        "category": "Task & Script Explorer",
        "icon": "$(debug-restart)"
      },
      {
        "command": "taskRunnerUltimate.showGroup",
        "title": "Show Package",
        "category": "Task & Script Explorer",
        "icon": "$(eye)"
      },
      {
        "command": "taskRunnerUltimate.openScript",
        "title": "Go to Script Definition",
        "category": "Task & Script Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "taskRunnerUltimate.openManifest",
        "title": "Open Manifest File",
        "category": "Task & Script Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "taskRunnerUltimate.showTerminal",
        "title": "Show Terminal (Click)",
        "category": "Task & Script Explorer",
        "icon": "$(terminal)"
      },
      {
        "command": "taskRunnerUltimate.openTerminalEditor",
        "title": "Open Terminal in Editor Area",
        "category": "Task & Script Explorer",
        "icon": "$(open-preview)"
      },
      {
        "command": "taskRunnerUltimate.setColor.red",
        "title": "🔴 Red",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.setColor.orange",
        "title": "🟠 Orange",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.setColor.yellow",
        "title": "🟡 Yellow",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.setColor.green",
        "title": "🟢 Green",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.setColor.teal",
        "title": "💠 Teal",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.setColor.blue",
        "title": "🔵 Blue",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.setColor.purple",
        "title": "🟣 Purple",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.setColor.pink",
        "title": "🌸 Pink",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.setColor.brown",
        "title": "🟤 Brown",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.setColor.gray",
        "title": "⚪ Gray",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.clearColor",
        "title": "Default",
        "category": "Task & Script Explorer"
      },
      {
        "command": "taskRunnerUltimate.pickIcon",
        "title": "Change Icon…",
        "category": "Task & Script Explorer",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "taskRunnerUltimate.menu",
        "title": "Menu",
        "category": "Task & Script Explorer",
        "icon": "$(menu)"
      },
      {
        "command": "taskRunnerUltimate.stopAll",
        "title": "Stop All Running Tasks",
        "category": "Task & Script Explorer",
