        "description": "Icon colour in the Scripts view: Running a dev server or watcher.",
        "defaults": {
          "dark": "#73C991",
          "light": "#388A34",
          "highContrast": "#89D185",
          "highContrastLight": "#0B6A0B"
        }
      },
      {
        "id": "packageScripts.category.test",
        "description": "Icon colour in the Scripts view: Tests and coverage.",
        "defaults": {
          "dark": "#F14C4C",
          "light": "#E51400",
          "highContrast": "#FF8A8A",
          "highContrastLight": "#B5000F"
        }
      },
      {
        "id": "packageScripts.category.quality",
        "description": "Icon colour in the Scripts view: Linting, formatting and type checking.",
        "defaults": {
